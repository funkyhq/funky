{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": [
    "apps/**/src/**/*.ts",
    "apps/api/test/**/*.ts",
    "apps/worker/test/**/*.ts",
    "packages/**/src/**/*.ts",
    "packages/**/test/**/*.ts"
  ],
  /* apps/web is a DOM + JSX program with its own tsconfigs; this one is
     node-typed and jsx-less. `pnpm typecheck` runs that project too. */
  "exclude": ["apps/web"]
}
